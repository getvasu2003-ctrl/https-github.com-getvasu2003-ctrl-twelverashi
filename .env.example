# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CASHFREE_APP_ID: Cashfree Payment Gateway App ID
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"

# CASHFREE_SECRET_KEY: Cashfree Payment Gateway Secret Key
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"

# CASHFREE_ENV: Cashfree environment (production or sandbox)
CASHFREE_ENV="production"

# CASHFREE_API_VERSION: Cashfree API version (default: 2023-08-01)
CASHFREE_API_VERSION="2023-08-01"

# MSG91_AUTH_KEY: (Optional) MSG91 API Authkey for live SMS & OTP dispatch
# Template ID: 6935bfc0a6240e24e80be279, Sender ID: TWRSHI
MSG91_AUTH_KEY="YOUR_MSG91_AUTH_KEY"

# JIO_DLT_PE_ID: Jio DLT Principal Entity ID
JIO_DLT_PE_ID="1201171886368224321"

# SMS_SENDER_HEADER: Approved TRAI 6-character header
SMS_SENDER_HEADER="TWRSHI"

# AGORA_APP_ID: Agora RTC App ID (Get free from https://console.agora.io)
AGORA_APP_ID="YOUR_AGORA_APP_ID"

# AGORA_APP_CERTIFICATE: (Optional) Agora RTC App Certificate for secure token generation
AGORA_APP_CERTIFICATE="YOUR_AGORA_APP_CERTIFICATE"
